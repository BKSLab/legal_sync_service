# --- Приложение ---
APP_NAME=Legal Sync Service
API_V1_PREFIX=/api/v1
LOGGING_CONFIG_PATH=logging.ini

# --- База данных (Postgres) ---
# Docker Compose: db:5432; Python вне Docker: localhost и порт вашей БД.
# Compose не переопределяет эти значения.
# Образ PostgreSQL создаёт базу с именем POSTGRES_NAME.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_NAME=legal_sync_service_local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# --- Админка (sqladmin) ---
SECRET_KEY=your_secret_key_for_admin_sessions
ADMIN_LOGIN=admin
ADMIN_PASSWORD=your_admin_password
# Для текущего запуска по HTTP оставьте false.
ADMIN_SESSION_HTTPS_ONLY=false

# --- Авторизация служебного REST API ---
API_KEY=your_legal_sync_service_api_key

# --- publication.pravo.gov.ru ---
PUBLICATION_PRAVO_BASE_URL=http://publication.pravo.gov.ru
PUBLICATION_PRAVO_TIMEOUT_SECONDS=30
PUBLICATION_PRAVO_MONITORING_BLOCKS=president,government
PUBLICATION_PRAVO_FEDERAL_LAW_DOCUMENT_TYPE_ID=82a8bf1c-3bc7-47ed-827f-7affd43a7f27
PUBLICATION_PRAVO_GOVERNMENT_DECREE_DOCUMENT_TYPE_ID=fd5a8766-f6fd-4ac2-8fd9-66f414d314ac

# --- Банк консолидированных редакций (actual.pravo.gov.ru) ---
# Порт 8000 нестандартный, но это значение из config.js самого портала.
PRAVO_EBPI_BASE_URL=http://actual.pravo.gov.ru:8000/api/ebpi
PRAVO_EBPI_BANK=ebpi
PRAVO_EBPI_TIMEOUT_SECONDS=120
PRAVO_EBPI_SEARCH_START_DATE=20220701
PRAVO_EBPI_MAX_RETRIES=3
PRAVO_EBPI_RETRY_DELAY_SECONDS=2.0
PRAVO_EBPI_MAX_CONCURRENT_REQUESTS=2

# --- RAG Service ---
# Режим наблюдения: события сохраняются в админке, отправка в RAG отключена.
RAG_DELIVERY_ENABLED=false
# HTTP-адрес сервера RAG. При переносе RAG замените IP на адрес нового сервера.
RAG_SERVICE_BASE_URL=http://91.218.115.104:8002
RAG_SERVICE_API_KEY=your_rag_service_api_key
RAG_SERVICE_TIMEOUT_SECONDS=60

# --- Планировщик ---
SCHEDULER_ENABLED=true
PROCESSING_MAX_RETRIES=3
# * — в начале каждого часа; 3 — ежедневно в 03:00 в зоне TIMEZONE.
MONITORING_CRON_HOUR=*
# Используется только при RAG_DELIVERY_ENABLED=true.
PROCESSING_CRON_HOUR=4
TIMEZONE=Europe/Moscow

# --- Запуск ---
# Внешний HTTP-порт nginx; приложение слушает 8000 только внутри Docker-сети.
LEGAL_SYNC_PORT=8003
RUN_MIGRATIONS_ON_START=true
HYPERCORN_WORKERS=2
